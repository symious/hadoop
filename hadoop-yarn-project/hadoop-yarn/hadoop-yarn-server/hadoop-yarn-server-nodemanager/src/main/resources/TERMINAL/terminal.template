  <html>
    <head>
      <meta charset="utf-8"/>
      <link rel="stylesheet" href="xterm/dist/xterm.css" />
      <link rel="stylesheet" href="css/style.css" />
      <script src="xterm/dist/xterm.js"></script>
      <script src="xterm/dist/xterm-addon-attach.js"></script>
      <script src="xterm/dist/xterm-addon-fit.js"></script>
      <script src="xterm/dist/xterm-addon-canvas.js"></script>
    </head>
    <body>
      <div id="terminal"></div>
      <script>
        function getQueryVariable(variable) {
          var query = window.location.search.substring(1);
          var vars = query.split('&');
          for (var i = 0; i < vars.length; i++) {
            var pair = vars[i].split('=');
            if (decodeURIComponent(pair[0]) == variable) {
              return decodeURIComponent(pair[1]);
            }
          }
          return null;
        }

        var arr = window.location.href.split("/");
        var protocol = "ws://";
        if (window.location.protocol=="https:") {
          protocol = "wss://";
        }
        var url = "ws://" + window.location.hostname + ":" + window.location.port
            + "/yarn-container/" + getQueryVariable("container");
        var user = getQueryVariable("user.name");
        if (user != null) {
          url = url + "?user.name=" + encodeURI(user);
        }
        document.title = getQueryVariable("container");
        console.log(url);

        var sock = new WebSocket(url);
        var term = new Terminal({
          cursorBlink: true,
        });

        attachAddon = new AttachAddon.AttachAddon(sock);
        fitAddon = new FitAddon.FitAddon();
        canvasAddon = new CanvasAddon.CanvasAddon();

        term.loadAddon(attachAddon);
        term.loadAddon(fitAddon);
//        term.open(document.getElementById('terminal'));
//        term.loadAddon(canvasAddon);
//        term.focus();
//        fitAddon.fit();

        sock.addEventListener('close', function(event) {
          switch(event.code) {
            case 1000:
              term.write('Remote Connection closed.');
              break;
            case 1008:
              term.write('Remote Connection refused.');
              break;
            case 1001:
              term.write('Remote Connection going away.');
              break;
            case 1003:
              term.write('Nonsecure mode is unsupported.');
              break;
          }
        });

        function resizeScreen() {
          fitAddon.fit();
          sock.send("RESIZE{" + term.cols + ":" + term.rows + "}");
        }

        sock.onopen = () => {
          term.open(document.getElementById('terminal'));
          term.loadAddon(canvasAddon);
          term.focus();
          resizeScreen();
        };

        window.addEventListener("resize", resizeScreen)

        function ping() {
          if (sock.readyState === WebSocket.OPEN) {
            sock.send("1{}");
          } else if(sock.readyState === WebSocket.CLOSED) {
            clearInterval(pingTimer);
          }
        }
//        var pingTimer = setInterval(ping, 10000);
      </script>
    </body>
  </html>
